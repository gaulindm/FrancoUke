import time
from django.db import connection
from django.test import Client
from django.test.utils import CaptureQueriesContext

PATH = "/strumsphere/songs/"   # e.g. "/songbook/songs/"

c = Client()
c.get(PATH, HTTP_HOST="francouke.pythonanywhere.com")   # warm-up run, ignored

with CaptureQueriesContext(connection) as ctx:
    t = time.time()
    r = c.get(PATH, HTTP_HOST="francouke.pythonanywhere.com")
    print("total:", round(time.time() - t, 2), "status:", r.status_code)

print("queries:", len(ctx), "db time:", round(sum(float(q["time"]) for q in ctx), 3))
for q in sorted(ctx, key=lambda q: -float(q["time"]))[:5]:
    print(q["time"], q["sql"][:200])